    "express-async-errors": "^3.1.1",
    "google-auth-library": "^9.14.1",
    "libphonenumber-js": "^1.13.9",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "tsx": "^4.10.5",
    "zod": "^3.22.0"
