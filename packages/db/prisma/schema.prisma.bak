

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum PayoutCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY

  @@map("payout_cycle")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("subscription_status")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  CONSULTANT
  CLIENT

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED

  @@map("account_status")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PHONE_CHANGE
  EMAIL_CHANGE

  @@map("otp_purpose")
}

enum ConsultantCategory {
  MEDICAL
  LEGAL
  IT
  PHYSIOTHERAPY
  HOMEOPATHY
  ASTROLOGY

  @@map("consultant_category")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum PaymentTimingPref {
  PAY_ON_BOOKING
  PAY_AFTER_SESSION

  @@map("payment_timing_pref")
}

enum VerificationDocType {
  MEDICAL_LICENSE
  BAR_REGISTRATION
  DEGREE_CERTIFICATE
  GOVERNMENT_ID
  PROFESSIONAL_CERTIFICATE
  OTHER

  @@map("verification_doc_type")
}

enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED

  @@map("slot_status")
}

enum CaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED

  @@map("case_status")
}

enum AppointmentSeriesStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("appointment_series_status")
}

enum SeriesPaymentMode {
  UPFRONT_FULL
  PER_OCCURRENCE

  @@map("series_payment_mode")
}

enum AppointmentStatus {
  REQUESTED
  APPROVED
  RESCHEDULE_PROPOSED
  RESCHEDULED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentMode {
  IN_PERSON
  AUDIO
  VIDEO_EXTERNAL

  @@map("appointment_mode")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status_enum")
}

enum InteractionType {
  RECORDED_AUDIO
  NOTE
  FOLLOW_UP_CALL
  MESSAGE
  SCRATCHPAD

  @@map("interaction_type")
}

enum TranscriptStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("transcript_status")
}

enum InteractionVisibility {
  CONSULTANT_ONLY
  SHARED_WITH_CLIENT

  @@map("interaction_visibility")
}

enum TemplateKind {
  COMMITMENT
  TASK

  @@map("template_kind")
}

enum CommitmentParty {
  CONSULTANT
  CLIENT

  @@map("commitment_party")
}

enum CommitmentStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  MISSED
  CANCELLED

  @@map("commitment_status")
}

enum CommitmentPriority {
  LOW
  MEDIUM
  HIGH

  @@map("commitment_priority")
}

enum TaskAssignee {
  CLIENT
  CONSULTANT

  @@map("task_assignee")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED

  @@map("task_status")
}

enum DocumentSource {
  DESKTOP_UPLOAD
  MOBILE_CAMERA
  SYSTEM_GENERATED

  @@map("document_source")
}

enum DocumentVisibility {
  CONSULTANT_ONLY
  SHARED_WITH_CLIENT

  @@map("document_visibility")
}

enum ChatRole {
  USER
  ASSISTANT

  @@map("chat_role")
}

enum ChatFeedback {
  THUMBS_UP
  THUMBS_DOWN

  @@map("chat_feedback")
}

enum AiSummaryType {
  SESSION_RECAP
  CASE_OVERVIEW

  @@map("ai_summary_type")
}

enum CitationSource {
  INTERACTION
  DOCUMENT

  @@map("citation_source")
}

enum GrievanceSubject {
  CONSULTANT
  TENANT_ADMIN
  BILLING
  PLATFORM
  OTHER

  @@map("grievance_subject")
}

enum GrievanceCategory {
  SERVICE_QUALITY
  MISCONDUCT
  BILLING_DISPUTE
  DATA_PRIVACY
  OTHER

  @@map("grievance_category")
}

enum GrievanceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("grievance_severity")
}

enum GrievanceStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED

  @@map("grievance_status")
}

enum ReferralRewardType {
  DISCOUNT_CODE
  CREDIT
  NONE

  @@map("referral_reward_type")
}

enum ReferralRewardStatus {
  PENDING
  GRANTED

  @@map("referral_reward_status")
}

enum ConsultantReferralStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("consultant_referral_status")
}

enum NotificationType {
  APPOINTMENT_REQUESTED
  APPOINTMENT_APPROVED
  APPOINTMENT_REJECTED
  RESCHEDULE_PROPOSED
  APPOINTMENT_CANCELLED
  SESSION_JOINING_SOON
  COMMITMENT_DUE_SOON
  COMMITMENT_MISSED
  TASK_DUE_SOON
  TASK_OVERDUE
  REVIEW_REQUESTED
  PAYMENT_RECEIVED
  PAYOUT_PROCESSED
  GRIEVANCE_SUBMITTED
  GRIEVANCE_STATUS_CHANGED
  REFERRAL_REDEEMED
  CONSULTANT_REFERRAL_RECEIVED
  WAITLIST_SLOT_AVAILABLE
  OTHER

  @@map("notification_type")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP

  @@map("notification_channel")
}

enum PaymentTxnStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_txn_status")
}

enum PayoutStatus {
  PENDING
  BLOCKED
  PROCESSED
  FAILED

  @@map("payout_status_enum")
}

enum DeletionRequestStatus {
  PENDING
  RESOLVED
  REJECTED

  @@map("deletion_request_status")
}

enum DeletionResolution {
  FULL_DELETION
  ANONYMIZED_RETAINED_RECORD
  REJECTED_LEGAL_HOLD

  @@map("deletion_resolution")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String       @unique @db.VarChar(63)
  customDomain           String?      @unique @map("custom_domain") @db.VarChar(255)
  displayName            String       @map("display_name") @db.VarChar(200)
  logoUrl                String?      @map("logo_url")
  themeConfig            Json         @default("{}") @map("theme_config")
  status                 TenantStatus @default(ACTIVE)
  planTier               String?      @default("STANDARD") @map("plan_tier") @db.VarChar(50)
  createdBySuperAdminId  String?      @map("created_by_super_admin_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBySuperAdmin User? @relation("TenantCreatedBy", fields: [createdBySuperAdminId], references: [id])

  settings                        TenantSettings?
  billing                         TenantBilling?
  users                           User[]                           @relation("UserTenant")
  clientProfiles                  ClientProfile[]
  clientCategoryProfiles          ClientCategoryProfile[]
  guardianLinks                   GuardianLink[]
  consultantProfiles              ConsultantProfile[]
  consultantVerificationDocuments ConsultantVerificationDocument[]
  availabilitySlots               AvailabilitySlot[]
  outOfOfficePeriods              OutOfOfficePeriod[]
  cases                           Case[]
  appointmentSeries               AppointmentSeries[]
  appointments                    Appointment[]
  interactions                    Interaction[]
  commitmentTemplates             CommitmentTemplate[]
  commitments                     Commitment[]
  tasks                           Task[]
  taskReminders                   TaskReminder[]
  documents                       Document[]
  chatMessages                    ChatMessage[]
  aiSummaries                     AiSummary[]
  ragCitations                    RagCitation[]
  reviews                         Review[]
  grievances                      Grievance[]
  consultantAnalyticsSnapshots    ConsultantAnalyticsSnapshot[]
  referrals                       Referral[]
  consultantReferrals             ConsultantReferral[]
  notifications                   Notification[]
  auditLogs                       AuditLog[]
  pushSubscriptions               PushSubscription[]
  otpVerifications                OtpVerification[]
  payments                        Payment[]
  caseDeletionRequests            CaseDeletionRequest[]

  @@map("tenants")
}

model TenantSettings {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String      @unique @map("tenant_id") @db.Uuid
  defaultCurrency       String      @default("INR") @map("default_currency") @db.VarChar(3)
  payoutCycle           PayoutCycle @default(WEEKLY) @map("payout_cycle")
  bookingCutoffHours    Int         @default(2) @map("booking_cutoff_hours") @db.SmallInt
  autoApproveBookings   Boolean     @default(false) @map("auto_approve_bookings")
  brandingColors        Json        @default("{}") @map("branding_colors")
  supportedLanguages    String[]    @default(["en"]) @map("supported_languages")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantBilling {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String              @unique @map("tenant_id") @db.Uuid
  planName              String              @map("plan_name") @db.VarChar(100)
  mrr                   Decimal             @default(0) @db.Decimal(12, 2)
  status                SubscriptionStatus  @default(TRIALING)
  renewsAt              DateTime?           @map("renews_at") @db.Timestamptz(6)
  platformCommissionPct Decimal             @default(0) @map("platform_commission_pct") @db.Decimal(5, 2)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("tenant_billing")
}

// ---------------------------------------------------------------------------
// Identity & Auth
// ---------------------------------------------------------------------------

model User {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String?       @map("tenant_id") @db.Uuid
  supabaseAuthUserId   String?       @unique @map("supabase_auth_user_id") @db.Uuid
  email                String        @db.VarChar(255)
  phone                String?       @db.VarChar(20)
  phoneVerified        Boolean       @default(false) @map("phone_verified")
  emailVerified        Boolean       @default(false) @map("email_verified")
  passwordHash         String?       @map("password_hash")
  authProviderId       String?       @map("auth_provider_id") @db.VarChar(255)
  role                 UserRole
  accountStatus        AccountStatus @default(ACTIVE) @map("account_status")
  isActive             Boolean       @default(true) @map("is_active")
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation("UserTenant", fields: [tenantId], references: [id])

  createdTenants                Tenant[]                 @relation("TenantCreatedBy")
  clientProfile                 ClientProfile?
  consultantProfile              ConsultantProfile?
  createdConsultantProfiles      ConsultantProfile[]      @relation("ConsultantCreatedBy")
  refreshTokens                    RefreshToken[]
  guardianLinks                      GuardianLink[]          @relation("GuardianUser")
  guardianLinksVerified                GuardianLink[]          @relation("GuardianLinkVerifiedBy")
  appointmentsRescheduleProposed         Appointment[]           @relation("AppointmentRescheduleProposedBy")
  appointmentsCancelled                    Appointment[]           @relation("AppointmentCancelledBy")
  appointmentsNoShowFlagged                  Appointment[]           @relation("AppointmentNoShowFlaggedBy")
  commitmentsFulfilled                         Commitment[]            @relation("CommitmentFulfilledBy")
  tasksCompleted                                 Task[]                  @relation("TaskCompletedBy")
  documentsUploaded                                Document[]              @relation("DocumentUploadedBy")
  chatMessages                                       ChatMessage[]           @relation("ChatMessageSender")
  grievancesAssigned                                    Grievance[]             @relation("GrievanceAssignedSuperAdmin")
  notifications                                           Notification[]
  notificationPreferences                                   NotificationPreference[]
  auditLogs                                                   AuditLog[]              @relation("AuditLogActor")
  pushSubscriptions                                              PushSubscription[]
  caseDeletionRequestsResolved                                      CaseDeletionRequest[]   @relation("CaseDeletionResolvedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([authProviderId])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("users")
}

model OtpVerification {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?    @map("tenant_id") @db.Uuid
  identifier String     @db.VarChar(255)
  otpHash    String     @map("otp_hash")
  purpose    OtpPurpose
  attempts   Int        @default(0) @db.SmallInt
  verified   Boolean    @default(false)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, identifier])
  @@map("otp_verifications")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  deviceHint String?   @map("device_hint") @db.VarChar(255)
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

model ClientProfile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  fullName              String    @map("full_name") @db.VarChar(200)
  dob                   DateTime? @db.Date
  isMinor               Boolean   @default(false) @map("is_minor")
  gender                String?   @db.VarChar(30)
  addressLine           String?   @map("address_line")
  city                  String?   @db.VarChar(100)
  state                 String?   @db.VarChar(100)
  pincode               String?   @db.VarChar(10)
  timezone              String    @default("Asia/Kolkata") @db.VarChar(50)
  preferredLanguage     String    @default("en") @map("preferred_language") @db.VarChar(50)
  profilePhotoUrl       String?   @map("profile_photo_url")
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(20)
  referralCode          String?   @unique @map("referral_code") @db.VarChar(20)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryProfiles     ClientCategoryProfile[]
  guardianLinks        GuardianLink[]
  cases                Case[]
  appointmentSeries    AppointmentSeries[]
  appointments         Appointment[]
  reviews              Review[]
  grievances           Grievance[]
  referralsMade        Referral[]            @relation("ReferringClient")
  referralsReceived    Referral[]            @relation("ReferredClient")
  consultantReferrals  ConsultantReferral[]
  payments             Payment[]
  caseDeletionRequests CaseDeletionRequest[]

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, isMinor])
  @@map("client_profiles")
}

model ClientCategoryProfile {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  clientId  String             @map("client_id") @db.Uuid
  category  ConsultantCategory
  data      Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, category])
  @@index([tenantId])
  @@index([clientId])
  @@map("client_category_profiles")
}

model GuardianLink {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  minorClientId      String    @map("minor_client_id") @db.Uuid
  guardianUserId     String    @map("guardian_user_id") @db.Uuid
  relationship       String    @db.VarChar(50)
  consentGiven       Boolean   @default(false) @map("consent_given")
  consentDocumentUrl String?   @map("consent_document_url")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  minorClient    ClientProfile @relation(fields: [minorClientId], references: [id], onDelete: Cascade)
  guardianUser   User          @relation("GuardianUser", fields: [guardianUserId], references: [id])
  verifiedByUser User?         @relation("GuardianLinkVerifiedBy", fields: [verifiedBy], references: [id])

  @@unique([minorClientId, guardianUserId])
  @@index([tenantId])
  @@index([minorClientId])
  @@index([guardianUserId])
  @@map("guardian_links")
}

// ---------------------------------------------------------------------------
// Consultant
// ---------------------------------------------------------------------------

model ConsultantProfile {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  userId                 String              @unique @map("user_id") @db.Uuid
  createdByTenantAdminId String?             @map("created_by_tenant_admin_id") @db.Uuid
  fullName               String              @map("full_name") @db.VarChar(200)
  category               ConsultantCategory
  subSpecialization      String?             @map("sub_specialization") @db.VarChar(150)
  bio                    String?
  qualifications         String[]
  yearsOfExperience      Int?                @map("years_of_experience") @db.SmallInt
  consultationFee        Decimal             @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  currency               String              @default("INR") @db.VarChar(3)
  languagesSpoken        String[]            @map("languages_spoken")
  timezone               String              @default("Asia/Kolkata") @db.VarChar(50)
  verificationStatus     VerificationStatus  @default(VERIFIED) @map("verification_status")
  ratingAvg              Decimal             @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount            Int                 @default(0) @map("rating_count")
  isAcceptingNewClients  Boolean             @default(true) @map("is_accepting_new_clients")
  autoApproveBookings    Boolean             @default(false) @map("auto_approve_bookings")
  paymentTiming          PaymentTimingPref   @default(PAY_ON_BOOKING) @map("payment_timing")
  payoutAccountDetails   Json?               @map("payout_account_details")
  calendarSyncIcsToken   String              @default(dbgenerated("gen_random_uuid()")) @map("calendar_sync_ics_token") @db.Uuid
  sourceTagNote          String?             @map("source_tag_note")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant @relation(fields: [tenantId], references: [id])
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByTenantAdmin User?  @relation("ConsultantCreatedBy", fields: [createdByTenantAdminId], references: [id])

  verificationDocuments ConsultantVerificationDocument[]
  availabilitySlots     AvailabilitySlot[]
  outOfOfficePeriods    OutOfOfficePeriod[]
  cases                 Case[]
  appointmentSeries     AppointmentSeries[]
  appointments          Appointment[]
  interactions          Interaction[]
  commitmentTemplates   CommitmentTemplate[]
  reviews               Review[]
  grievanceSubjectOf    Grievance[]                   @relation("GrievanceSubjectConsultant")
  analyticsSnapshots    ConsultantAnalyticsSnapshot[]
  referrals             Referral[]
  referralsFrom         ConsultantReferral[]          @relation("ReferralFromConsultant")
  referralsTo           ConsultantReferral[]          @relation("ReferralToConsultant")
  payments              Payment[]

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, category])
  @@index([tenantId, category, isAcceptingNewClients, ratingAvg])
  @@map("consultant_profiles")
}

model ConsultantVerificationDocument {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  consultantId      String              @map("consultant_id") @db.Uuid
  documentType      VerificationDocType @map("document_type")
  fileUrl           String              @map("file_url")
  fileName          String              @map("file_name") @db.VarChar(255)
  issuingAuthority  String?             @map("issuing_authority") @db.VarChar(255)
  issuedDate        DateTime?           @map("issued_date") @db.Date
  expiryDate        DateTime?           @map("expiry_date") @db.Date
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([consultantId])
  @@index([expiryDate])
  @@map("consultant_verification_documents")
}

model AvailabilitySlot {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  consultantId       String     @map("consultant_id") @db.Uuid
  dayOfWeek          Int?       @map("day_of_week") @db.SmallInt
  specificDate       DateTime?  @map("specific_date") @db.Date
  startTime          DateTime   @map("start_time") @db.Time
  endTime            DateTime   @map("end_time") @db.Time
  slotDurationMins   Int        @default(30) @map("slot_duration_mins") @db.SmallInt
  isRecurring        Boolean    @default(true) @map("is_recurring")
  bufferBeforeMins   Int        @default(0) @map("buffer_before_mins") @db.SmallInt
  bufferAfterMins    Int        @default(0) @map("buffer_after_mins") @db.SmallInt
  maxBookingsPerSlot Int        @default(1) @map("max_bookings_per_slot") @db.SmallInt
  status             SlotStatus @default(OPEN)
  blockReason        String?    @map("block_reason")
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([tenantId])
  @@index([consultantId])
  @@index([specificDate])
  @@index([consultantId, status])
  @@map("availability_slots")
}

model OutOfOfficePeriod {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  consultantId       String   @map("consultant_id") @db.Uuid
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  autoReplyMessage   String?  @map("auto_reply_message")
  pausesNewBookings  Boolean  @default(true) @map("pauses_new_bookings")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([consultantId, startDate, endDate])
  @@map("out_of_office_periods")
}

// ---------------------------------------------------------------------------
// Cases, Appointments, Interactions
// ---------------------------------------------------------------------------

model Case {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  clientId      String     @map("client_id") @db.Uuid
  consultantId  String     @map("consultant_id") @db.Uuid
  category      ConsultantCategory
  matterKey     String?    @map("matter_key") @db.VarChar(150)
  status        CaseStatus @default(ACTIVE)
  tags          String[]   @default([])
  closedAt      DateTime?  @map("closed_at") @db.Timestamptz(6)
  closureReason String?    @map("closure_reason")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  client     ClientProfile     @relation(fields: [clientId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id])

  appointmentSeries              AppointmentSeries[]
  appointments                   Appointment[]
  interactions                   Interaction[]
  commitments                    Commitment[]
  tasks                          Task[]
  documents                      Document[]
  chatMessages                   ChatMessage[]
  aiSummaries                    AiSummary[]
  reviews                        Review[]
  grievances                     Grievance[]
  consultantReferralsAsSource    ConsultantReferral[] @relation("ConsultantReferralSourceCase")
  consultantReferralsAsResulting ConsultantReferral[] @relation("ConsultantReferralResultingCase")
  caseDeletionRequests           CaseDeletionRequest[]

  @@unique([clientId, consultantId, matterKey])
  @@index([tenantId])
  @@index([clientId])
  @@index([consultantId])
  @@index([clientId, consultantId])
  @@index([tenantId, status])
  @@map("cases")
}

model AppointmentSeries {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  caseId          String                  @map("case_id") @db.Uuid
  consultantId    String                  @map("consultant_id") @db.Uuid
  clientId        String                  @map("client_id") @db.Uuid
  dayOfWeek       Int                     @map("day_of_week") @db.SmallInt
  startTime       DateTime                @map("start_time") @db.Time
  endTime         DateTime                @map("end_time") @db.Time
  seriesStartDate DateTime                @map("series_start_date") @db.Date
  seriesEndDate   DateTime?               @map("series_end_date") @db.Date
  occurrenceCount Int?                    @map("occurrence_count") @db.SmallInt
  status          AppointmentSeriesStatus @default(ACTIVE)
  paymentMode     SeriesPaymentMode       @default(PER_OCCURRENCE) @map("payment_mode")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  case       Case              @relation(fields: [caseId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id])
  client     ClientProfile     @relation(fields: [clientId], references: [id])

  appointments Appointment[]

  @@index([tenantId])
  @@index([caseId])
  @@index([consultantId])
  @@index([status])
  @@map("appointment_series")
}

model Appointment {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String             @map("tenant_id") @db.Uuid
  caseId                   String             @map("case_id") @db.Uuid
  seriesId                 String?            @map("series_id") @db.Uuid
  clientId                 String             @map("client_id") @db.Uuid
  consultantId             String             @map("consultant_id") @db.Uuid
  slotId                   String?            @map("slot_id") @db.Uuid
  scheduledStart           DateTime           @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd             DateTime           @map("scheduled_end") @db.Timestamptz(6)
  status                   AppointmentStatus  @default(REQUESTED)
  rejectionReason          String?            @map("rejection_reason")
  rescheduleReason         String?            @map("reschedule_reason")
  rescheduleProposedBy     String?            @map("reschedule_proposed_by") @db.Uuid
  rescheduleProposedStart  DateTime?          @map("reschedule_proposed_start") @db.Timestamptz(6)
  rescheduleProposedEnd    DateTime?          @map("reschedule_proposed_end") @db.Timestamptz(6)
  rescheduleExpiresAt      DateTime?          @map("reschedule_expires_at") @db.Timestamptz(6)
  mode                     AppointmentMode    @default(VIDEO_EXTERNAL)
  meetingLink              String?            @map("meeting_link")
  waitlistedClientIds      String[]           @default([]) @map("waitlisted_client_ids") @db.Uuid
  feeAmount                Decimal?           @map("fee_amount") @db.Decimal(10, 2)
  currency                 String             @default("INR") @db.VarChar(3)
  paymentStatus            PaymentStatus      @default(UNPAID) @map("payment_status")
  cancellationReason       String?            @map("cancellation_reason")
  cancelledBy              String?            @map("cancelled_by") @db.Uuid
  cancelledAt              DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  noShowDisputed           Boolean            @default(false) @map("no_show_disputed")
  noShowFlaggedBy          String?            @map("no_show_flagged_by") @db.Uuid
  requestExpiresAt         DateTime?          @map("request_expires_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant                   Tenant             @relation(fields: [tenantId], references: [id])
  case                     Case               @relation(fields: [caseId], references: [id])
  series                   AppointmentSeries? @relation(fields: [seriesId], references: [id])
  client                   ClientProfile      @relation(fields: [clientId], references: [id])
  consultant               ConsultantProfile  @relation(fields: [consultantId], references: [id])
  slot                     AvailabilitySlot?  @relation(fields: [slotId], references: [id])
  rescheduleProposedByUser User?              @relation("AppointmentRescheduleProposedBy", fields: [rescheduleProposedBy], references: [id])
  cancelledByUser          User?              @relation("AppointmentCancelledBy", fields: [cancelledBy], references: [id])
  noShowFlaggedByUser      User?              @relation("AppointmentNoShowFlaggedBy", fields: [noShowFlaggedBy], references: [id])

  interactions Interaction[]
  reviews      Review[]
  payments     Payment[]

  @@index([tenantId])
  @@index([caseId])
  @@index([seriesId])
  @@index([clientId])
  @@index([consultantId])
  @@index([tenantId, status])
  @@index([scheduledStart])
  @@index([requestExpiresAt])
  @@map("appointments")
}

model Interaction {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String                @map("tenant_id") @db.Uuid
  caseId                   String                @map("case_id") @db.Uuid
  appointmentId            String?               @map("appointment_id") @db.Uuid
  consultantId             String                @map("consultant_id") @db.Uuid
  type                     InteractionType
  occurredAt               DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(6)
  rawAudioUrl              String?               @map("raw_audio_url")
  audioDurationSeconds     Int?                  @map("audio_duration_seconds")
  isPartialCapture         Boolean               @default(false) @map("is_partial_capture")
  transcriptText           String?               @map("transcript_text")
  transcriptStatus         TranscriptStatus      @default(NOT_APPLICABLE) @map("transcript_status")
  transcriptLanguage       String?               @map("transcript_language") @db.VarChar(10)
  transcriptConfidence     Decimal?              @map("transcript_confidence") @db.Decimal(3, 2)
  notesText                String?               @map("notes_text")
  consentGiven             Boolean?              @map("consent_given")
  visibility               InteractionVisibility @default(CONSULTANT_ONLY)
  isDeleted                Boolean               @default(false) @map("is_deleted")
  deletedAt                DateTime?             @map("deleted_at") @db.Timestamptz(6)
  deleteRecoverableUntil   DateTime?             @map("delete_recoverable_until") @db.Timestamptz(6)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  case        Case              @relation(fields: [caseId], references: [id])
  appointment Appointment?      @relation(fields: [appointmentId], references: [id])
  consultant  ConsultantProfile @relation(fields: [consultantId], references: [id])

  commitments  Commitment[]
  tasks        Task[]
  documents    Document[]
  aiSummaries  AiSummary[]

  @@index([tenantId])
  @@index([caseId])
  @@index([appointmentId])
  @@index([transcriptStatus])
  @@index([caseId, occurredAt])
  @@map("interactions")
}

// ---------------------------------------------------------------------------
// Commitments & Tasks
// ---------------------------------------------------------------------------

model CommitmentTemplate {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  consultantId    String             @map("consultant_id") @db.Uuid
  kind            TemplateKind
  title           String             @db.VarChar(200)
  description     String
  defaultPriority CommitmentPriority @default(MEDIUM) @map("default_priority")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  commitments Commitment[]
  tasks       Task[]

  @@index([tenantId])
  @@index([consultantId, kind])
  @@map("commitment_templates")
}

model Commitment {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  caseId        String             @map("case_id") @db.Uuid
  interactionId String?            @map("interaction_id") @db.Uuid
  templateId    String?            @map("template_id") @db.Uuid
  madeBy        CommitmentParty    @map("made_by")
  description   String
  dueDate       DateTime           @map("due_date") @db.Date
  status        CommitmentStatus   @default(PENDING)
  fulfilledAt   DateTime?          @map("fulfilled_at") @db.Timestamptz(6)
  fulfilledBy   String?            @map("fulfilled_by") @db.Uuid
  priority      CommitmentPriority @default(MEDIUM)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  case            Case                @relation(fields: [caseId], references: [id])
  interaction     Interaction?        @relation(fields: [interactionId], references: [id])
  template        CommitmentTemplate? @relation(fields: [templateId], references: [id])
  fulfilledByUser User?               @relation("CommitmentFulfilledBy", fields: [fulfilledBy], references: [id])

  @@index([tenantId])
  @@index([caseId])
  @@index([dueDate])
  @@index([tenantId, status])
  @@map("commitments")
}

model Task {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  caseId        String              @map("case_id") @db.Uuid
  interactionId String?             @map("interaction_id") @db.Uuid
  templateId    String?             @map("template_id") @db.Uuid
  assignedTo    TaskAssignee        @default(CLIENT) @map("assigned_to")
  title         String              @db.VarChar(200)
  description   String?
  dueDate       DateTime?           @map("due_date") @db.Date
  status        TaskStatus          @default(PENDING)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  completedBy   String?             @map("completed_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  case            Case                @relation(fields: [caseId], references: [id])
  interaction     Interaction?        @relation(fields: [interactionId], references: [id])
  template        CommitmentTemplate? @relation(fields: [templateId], references: [id])
  completedByUser User?               @relation("TaskCompletedBy", fields: [completedBy], references: [id])

  reminders TaskReminder[]

  @@index([tenantId])
  @@index([caseId])
  @@index([dueDate])
  @@index([tenantId, status])
  @@map("tasks")
}

model TaskReminder {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  taskId    String              @map("task_id") @db.Uuid
  remindAt  DateTime            @map("remind_at") @db.Timestamptz(6)
  channel   NotificationChannel
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([remindAt])
  @@map("task_reminders")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  caseId                 String             @map("case_id") @db.Uuid
  interactionId          String?            @map("interaction_id") @db.Uuid
  uploadedBy             String             @map("uploaded_by") @db.Uuid
  previousVersionId      String?            @map("previous_version_id") @db.Uuid
  versionNumber          Int                @default(1) @map("version_number")
  fileUrl                String             @map("file_url")
  fileName               String             @map("file_name") @db.VarChar(255)
  mimeType               String?            @map("mime_type") @db.VarChar(100)
  fileSizeBytes          BigInt?            @map("file_size_bytes")
  source                 DocumentSource     @default(DESKTOP_UPLOAD)
  visibility             DocumentVisibility @default(CONSULTANT_ONLY)
  isDeleted              Boolean            @default(false) @map("is_deleted")
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deleteRecoverableUntil DateTime?          @map("delete_recoverable_until") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  case            Case         @relation(fields: [caseId], references: [id])
  interaction     Interaction? @relation(fields: [interactionId], references: [id])
  uploadedByUser  User         @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])
  previousVersion Document?    @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  nextVersions    Document[]   @relation("DocumentVersions")

  @@index([tenantId])
  @@index([caseId])
  @@index([caseId, isDeleted])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// AI Chat, Summaries, RAG
// ---------------------------------------------------------------------------

model ChatMessage {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  caseId     String        @map("case_id") @db.Uuid
  senderId   String        @map("sender_id") @db.Uuid
  senderRole UserRole      @map("sender_role")
  role       ChatRole
  content    String
  feedback   ChatFeedback?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  case   Case   @relation(fields: [caseId], references: [id])
  sender User   @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([tenantId])
  @@index([caseId, createdAt])
  @@map("chat_messages")
}

model AiSummary {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  caseId        String                 @map("case_id") @db.Uuid
  interactionId String?                @map("interaction_id") @db.Uuid
  summaryType   AiSummaryType          @default(SESSION_RECAP) @map("summary_type")
  content       String
  visibility    InteractionVisibility  @default(CONSULTANT_ONLY)
  isFlagged     Boolean                @default(false) @map("is_flagged")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  case        Case         @relation(fields: [caseId], references: [id])
  interaction Interaction? @relation(fields: [interactionId], references: [id])

  ragCitations RagCitation[]

  @@index([tenantId])
  @@index([caseId])
  @@map("ai_summaries")
}

model RagCitation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  parentId   String         @map("parent_id") @db.Uuid
  sourceType CitationSource @map("source_type")
  sourceId   String         @map("source_id") @db.Uuid
  excerpt    String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  parent AiSummary @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([parentId])
  @@map("rag_citations")
}

// ---------------------------------------------------------------------------
// Reviews & Grievances
// ---------------------------------------------------------------------------

model Review {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  caseId        String   @map("case_id") @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  consultantId  String   @map("consultant_id") @db.Uuid
  rating        Int      @db.SmallInt
  npsScore      Int?     @map("nps_score") @db.SmallInt
  reviewText    String?  @map("review_text")
  isVisible     Boolean  @default(true) @map("is_visible")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  case        Case              @relation(fields: [caseId], references: [id])
  appointment Appointment       @relation(fields: [appointmentId], references: [id])
  client      ClientProfile     @relation(fields: [clientId], references: [id])
  consultant  ConsultantProfile @relation(fields: [consultantId], references: [id])

  @@index([tenantId])
  @@index([consultantId])
  @@index([caseId])
  @@map("reviews")
}

model Grievance {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  clientId               String            @map("client_id") @db.Uuid
  subjectType            GrievanceSubject  @map("subject_type")
  subjectConsultantId    String?           @map("subject_consultant_id") @db.Uuid
  caseId                 String?           @map("case_id") @db.Uuid
  category               GrievanceCategory
  description            String
  attachmentUrls         String[]          @default([]) @map("attachment_urls")
  severity               GrievanceSeverity @default(MEDIUM)
  status                 GrievanceStatus   @default(OPEN)
  assignedToSuperAdminId String?           @map("assigned_to_super_admin_id") @db.Uuid
  resolutionNotes        String?           @map("resolution_notes")
  resolvedAt             DateTime?         @map("resolved_at") @db.Timestamptz(6)
  submittedAt            DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  client               ClientProfile      @relation(fields: [clientId], references: [id])
  subjectConsultant    ConsultantProfile? @relation("GrievanceSubjectConsultant", fields: [subjectConsultantId], references: [id])
  case                 Case?              @relation(fields: [caseId], references: [id])
  assignedToSuperAdmin User?              @relation("GrievanceAssignedSuperAdmin", fields: [assignedToSuperAdminId], references: [id])

  @@index([clientId])
  @@index([status, severity])
  @@index([assignedToSuperAdminId])
  @@map("grievances")
}

// ---------------------------------------------------------------------------
// Analytics, Referrals
// ---------------------------------------------------------------------------

model ConsultantAnalyticsSnapshot {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  consultantId             String   @map("consultant_id") @db.Uuid
  snapshotDate             DateTime @map("snapshot_date") @db.Date
  bookedHours7d            Decimal  @default(0) @map("booked_hours_7d") @db.Decimal(6, 2)
  overdueCommitmentCount   Int      @default(0) @map("overdue_commitment_count")
  overdueTaskCount         Int      @default(0) @map("overdue_task_count")
  burnoutFlag              Boolean  @default(false) @map("burnout_flag")
  repeatBookingRate        Decimal? @map("repeat_booking_rate") @db.Decimal(5, 2)
  avgFeeRealized           Decimal? @map("avg_fee_realized") @db.Decimal(10, 2)
  slotCancellationRates    Json     @default("{}") @map("slot_cancellation_rates")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@unique([consultantId, snapshotDate])
  @@index([tenantId])
  @@index([consultantId, snapshotDate(sort: Desc)])
  @@map("consultant_analytics_snapshot")
}

model Referral {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  consultantId      String                 @map("consultant_id") @db.Uuid
  referringClientId String                 @map("referring_client_id") @db.Uuid
  referredClientId  String?                @map("referred_client_id") @db.Uuid
  referralCode      String                 @map("referral_code") @db.VarChar(20)
  rewardType        ReferralRewardType     @default(NONE) @map("reward_type")
  rewardStatus      ReferralRewardStatus   @default(PENDING) @map("reward_status")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  consultant      ConsultantProfile @relation(fields: [consultantId], references: [id])
  referringClient ClientProfile     @relation("ReferringClient", fields: [referringClientId], references: [id])
  referredClient  ClientProfile?    @relation("ReferredClient", fields: [referredClientId], references: [id])

  @@index([tenantId])
  @@index([referringClientId])
  @@index([referralCode])
  @@map("referrals")
}

model ConsultantReferral {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  fromConsultantId String                   @map("from_consultant_id") @db.Uuid
  toConsultantId   String                   @map("to_consultant_id") @db.Uuid
  clientId         String                   @map("client_id") @db.Uuid
  sourceCaseId     String                   @map("source_case_id") @db.Uuid
  resultingCaseId  String?                  @map("resulting_case_id") @db.Uuid
  contextNote      String                   @map("context_note")
  status           ConsultantReferralStatus @default(PENDING)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt      DateTime?                @map("responded_at") @db.Timestamptz(6)

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  fromConsultant ConsultantProfile @relation("ReferralFromConsultant", fields: [fromConsultantId], references: [id])
  toConsultant   ConsultantProfile @relation("ReferralToConsultant", fields: [toConsultantId], references: [id])
  client         ClientProfile     @relation(fields: [clientId], references: [id])
  sourceCase     Case              @relation("ConsultantReferralSourceCase", fields: [sourceCaseId], references: [id])
  resultingCase  Case?             @relation("ConsultantReferralResultingCase", fields: [resultingCaseId], references: [id])

  @@index([tenantId])
  @@index([toConsultantId, status])
  @@index([fromConsultantId, status])
  @@map("consultant_referrals")
}

// ---------------------------------------------------------------------------
// Notifications, Audit, Push
// ---------------------------------------------------------------------------

model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?             @map("tenant_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  type              NotificationType
  channel           NotificationChannel
  title             String              @db.VarChar(255)
  body              String?
  relatedEntityType String?             @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?             @map("related_entity_id") @db.Uuid
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  leadTimeMinutes  Int?                @map("lead_time_minutes")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model AuditLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String?  @map("tenant_id") @db.Uuid
  actorUserId         String   @map("actor_user_id") @db.Uuid
  actorRole           UserRole @map("actor_role")
  isCrossTenantAccess Boolean  @default(false) @map("is_cross_tenant_access")
  action              String   @db.VarChar(100)
  entityType          String   @map("entity_type") @db.VarChar(50)
  entityId            String?  @map("entity_id") @db.Uuid
  reason              String?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  actorUser User    @relation("AuditLogActor", fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([actorUserId])
  @@index([isCrossTenantAccess])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Payments & Case Deletion (ported from v1 §2.20/§2.24, tenant_id added per
// the v2 "denormalize tenant_id onto every tenant-scoped table" principle —
// v2 §1 ERD lists both as hanging off the tenant boundary, but neither has a
// full v2 CREATE TABLE definition; `invoices` from v1 is not part of the v2
// ERD/table list and is intentionally omitted here.)
// ---------------------------------------------------------------------------

model Payment {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  appointmentId          String           @map("appointment_id") @db.Uuid
  clientId               String           @map("client_id") @db.Uuid
  consultantId           String           @map("consultant_id") @db.Uuid
  razorpayOrderId        String?          @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId      String?          @unique @map("razorpay_payment_id") @db.VarChar(100)
  amount                 Decimal          @db.Decimal(10, 2)
  currency               String           @default("INR") @db.VarChar(3)
  status                 PaymentTxnStatus @default(CREATED)
  refundAmount           Decimal          @default(0) @map("refund_amount") @db.Decimal(10, 2)
  refundReason           String?          @map("refund_reason")
  platformFee            Decimal?         @map("platform_fee") @db.Decimal(10, 2)
  consultantPayoutAmount Decimal?         @map("consultant_payout_amount") @db.Decimal(10, 2)
  payoutStatus           PayoutStatus     @default(PENDING) @map("payout_status")
  payoutProcessedAt      DateTime?        @map("payout_processed_at") @db.Timestamptz(6)
  webhookReceivedAt      DateTime?        @map("webhook_received_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  appointment Appointment       @relation(fields: [appointmentId], references: [id])
  client      ClientProfile     @relation(fields: [clientId], references: [id])
  consultant  ConsultantProfile @relation(fields: [consultantId], references: [id])

  @@index([appointmentId])
  @@index([consultantId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model CaseDeletionRequest {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  clientId        String                 @map("client_id") @db.Uuid
  caseId          String?                @map("case_id") @db.Uuid
  requestedAt     DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  status          DeletionRequestStatus  @default(PENDING)
  resolution      DeletionResolution?
  resolutionNotes String?                @map("resolution_notes")
  resolvedBy      String?                @map("resolved_by") @db.Uuid
  resolvedAt      DateTime?              @map("resolved_at") @db.Timestamptz(6)

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  client         ClientProfile @relation(fields: [clientId], references: [id])
  case           Case?         @relation(fields: [caseId], references: [id])
  resolvedByUser User?         @relation("CaseDeletionResolvedBy", fields: [resolvedBy], references: [id])

  @@index([clientId])
  @@index([status])
  @@map("case_deletion_requests")
}
