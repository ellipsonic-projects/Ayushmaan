{
  "name": "@ayushman/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./rls-context": "./src/rls-context.ts"
  },
  "typesVersions": {
    "*": {
      "rls-context": [
        "./src/rls-context.ts"
      ]
    }
  },
  "files": [
    "src",
    "prisma"
  ],
  "scripts": {
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed-superadmin.ts",
    "db:seed:tenant": "tsx prisma/seed-tenant.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ayushman/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@ayushman/config": "workspace:*",
    "@prisma/config": "^7.8.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "prisma": "^7.8.0",
    "tsx": "^4.10.5",
    "typescript": "5.7.3"
  }
}
